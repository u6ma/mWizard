! Default menu and keybinding configuration for mWizard.
! Copy this file to ~/.mwizardrc for customization.

! Command variables.
!
! Each entry is exported to the environment, and every command mWizard runs
! goes through "sh -c", so "$NAME" in any f.exec string is substituted by the
! shell. Set a program once here and change it in one place. Ordinary shell
! syntax works too, so "${TERMINAL:-xterm}" falls back when unset, and
! "$TERMINAL -e mutt" passes arguments.
!
! These names are the conventional ones, so programs that already honour
! EDITOR or BROWSER pick them up as well. mWand reads its own Variables
! block from ~/.mwandrc -- it is a separate program and does not inherit
! these unless mWizard started it.
Variables
{
	TERMINAL	xterm
	BROWSER		chromium-bin
	EDITOR		nedit
}

! Programs to run at startup.
!
! One command per line, run once the window manager is ready to manage what
! they map -- so this replaces adding them to ~/.xinitrc. Commands go through
! the same shell as f.exec, so "$TERMINAL", pipelines and "&" all work, and
! the Variables block above is already in effect.
!
! Run again on f.restart: the copies started by the previous instance are
! ended first, so a restart re-reads this file and starts what it now says.
! That is how to try out a change to this block, and it means a restart
! refreshes the session rather than the window manager alone.
!
! Anything that should survive a restart untouched does not belong here -- a
! wallpaper setter, or anything else that should run once for the life of the
! X session, still belongs in ~/.xinitrc.
Startup
{
	! Notification daemon. A dunst configuration matching the Motif colors
	! is installed as /etc/X11/dunstrc; copy it to ~/.config/dunst/dunstrc.
	! Harmless if dunst is not installed -- the command simply fails.
	dunst

	! The launcher panel, if you built it with "make mwand".
!	mwand
}

! Root Menu.
!
! What opens on the first press is kept short: anything that names a whole
! class of things pulls right into a menu of its own, the way mWand's launcher
! menus do. f.menu is what makes a pull-right, and the menu it names is an
! ordinary Menu block like this one -- defined below, and free to contain
! another f.menu in turn.
!
! Nothing stops you flattening it again: move an entry up here and it is on
! the first press. The three most-reached-for things already are.
Menu DefaultRootMenu
{
	"Main Menu"		f.title
	"Programs"	_P	f.menu	ProgramsMenu
	"Windows"	_W	f.menu	WindowsMenu
	"Workspaces"	_k	f.menu	WorkspacesMenu
	 no-label		f.separator
	"Execute..."	_E	f.run
	! mWinfo, the About window. Off here by default because it is already
	! on Alt Shift Ctrl<Key>i and in mWand's Commands menu; uncomment to
	! have it in the root menu as well.
!	"About mWizard..." _A	f.about
	 no-label		f.separator
	"Session"	_S	f.menu	SessionMenu
}

! The programs from the Variables block at the top of this file. Add your own
! here rather than to the root menu and the first press stays one line long
! however many you end up with.
Menu ProgramsMenu
{
	"New Terminal"	_T	f.exec "$TERMINAL &"
	"Web Browser"	_W	f.exec "$BROWSER &"
	"Text Editor"	_E	f.exec "$EDITOR &"
}

Menu WindowsMenu
{
	"Shuffle Up"	_U	f.circle_up
	"Shuffle Down"	_D	f.circle_down
	 no-label		f.separator
	"Pack Icons"	_P	f.pack_icons
	"Refresh"	_R	f.refresh
}

! Add Workspace and Remove Workspace act on the active workspace. Removing one
! is not a way to lose windows: clients that live only there are moved to the
! next workspace first, and the last workspace cannot be removed at all.
Menu WorkspacesMenu
{
	"Next Workspace"	_N	f.next_workspace
	"Prev. Workspace"	_P	f.prev_workspace
	 no-label			f.separator
	"Add Workspace"		_A	f.create_workspace
	"Remove Workspace"	_R	f.delete_workspace
}

! Suspend, Reboot and Shut Down run the commands set in the Settings block
! below; an empty one there disables its entry here. Restart re-reads this
! file and starts the Startup block over -- see the comment on that block.
Menu SessionMenu
{
	"Lock Screen"	_L	f.exec "i3lock -c 000000"
	 no-label		f.separator
	"Restart..."	_R	f.restart
	"Log Out..."	_O	f.logout
	 no-label		f.separator
	"Suspend"	_S	f.suspend
	"Reboot..."	_b	f.reboot
	"Shut Down..."	_D	f.shutdown
}

! Window menu
Menu DefaultWindowMenu
{
	Restore		_R	Alt<Key>F5	f.restore
	Move		_M	Alt<Key>F7	f.move
	Size		_S	Alt<Key>F8	f.resize
	Minimize	_n	Alt<Key>F9	f.minimize
	Maximize	_x	Alt<Key>F10	f.maximize
	Lower		_L	Alt<Key>F3	f.lower
	no-label				f.separator
	"Occupy Workspace..."	_O	Alt<Key>F2 f.workspace_presence
	"Occupy All Workspaces"	_A	f.occupy_all
	"Unoccupy Workspace"	_U	f.remove
	no-label				f.separator	
	Close		_C	Alt<Key>F4	f.kill
}


! Key Bindings
Keys DefaultKeyBindings
{
	Shift<Key>Escape window|icon	f.post_wmenu
	Alt<Key>space window|icon		f.post_wmenu
	Alt<Key>Tab	root|icon|window	f.next_key
	Alt Shift<Key>Tab root|icon|window	f.prev_key
	Alt<Key>Escape root|icon|window	f.circle_down
	Alt Shift<Key>Escape root|icon|window	f.circle_up
	Alt<Key>F6 window f.next_key transient
	Alt Shift<Key>F6 window f.prev_key transient
	Shift<Key>F10 icon f.post_wmenu
	Alt Shift<Key>Delete root|icon|window f.restart

	! Workspaces. Alt Shift 1 and 2 step through them; the keysym is the
	! unshifted one, since the grab is on the key and the modifier mask.
	Alt Shift<Key>1 root|icon|window	f.prev_workspace
	Alt Shift<Key>2 root|icon|window	f.next_workspace

	! Jump straight to one workspace. Change ws0 to whichever you want as
	! the one Home returns to -- workspaces are named ws0, ws1 and so on
	! unless renamed in a Workspace block.
	!
	! NOTE: this grabs Home in the window context, so applications never
	! see it -- Home stops working in text fields, terminals and browsers.
	! If you would rather keep it, comment this line out and uncomment the
	! Alt<Key>Home one below, or drop "|window" to leave it bound only on
	! the desktop and icons.
	<Key>Home root|icon|window		f.goto_workspace ws0
!	Alt<Key>Home root|icon|window		f.goto_workspace ws0

	! Terminal
	Alt Shift<Key>Return root|icon|window	f.exec "$TERMINAL &"

	! The command prompt.
	!
	! F1 rather than the more usual F2: the window menu above already binds
	! Alt<Key>F2 to f.workspace_presence, and menu accelerators are grabbed
	! the same way these are.
	Alt<Key>F1 root|icon|window		f.run

	! mWinfo: the name, the version, the licenses and the project page.
	Alt Shift Ctrl<Key>i root|icon|window	f.about

	! Media and other XF86 keys.
	!
	! Any name XStringToKeysym(3) knows works here, which covers all of
	! XF86keysym.h. A binding needs no modifier at all, and the key has to
	! exist on your keymap -- check with xev(1) if one does nothing, and
	! note that a desktop agent already grabbing it wins over mWizard.
	!
	!	<Key>XF86AudioRaiseVolume root|icon|window f.exec "pactl set-sink-volume @DEFAULT_SINK@ +5%"
	!	<Key>XF86AudioLowerVolume root|icon|window f.exec "pactl set-sink-volume @DEFAULT_SINK@ -5%"
	!	<Key>XF86AudioMute root|icon|window f.exec "pactl set-sink-mute @DEFAULT_SINK@ toggle"
	!	<Key>XF86AudioMicMute root|icon|window f.exec "pactl set-source-mute @DEFAULT_SOURCE@ toggle"
	!	<Key>XF86MonBrightnessUp root|icon|window f.exec "brightnessctl set +10%"
	!	<Key>XF86MonBrightnessDown root|icon|window f.exec "brightnessctl set 10%-"
	!	<Key>XF86AudioPlay root|icon|window f.exec "playerctl play-pause"
	!	<Key>XF86AudioNext root|icon|window f.exec "playerctl next"
	!	<Key>XF86AudioPrev root|icon|window f.exec "playerctl previous"
}

! Mouse Button Bindins
Buttons DefaultButtonBindings
{
	<Btn1Down>	icon|frame	f.raise
	<Btn3Down>	icon|frame	f.post_wmenu
	<Btn3Down>	root		f.menu	DefaultRootMenu
}
 
Buttons ExplicitButtonBindings
{
	<Btn1Down>	frame|icon	f.raise
	<Btn3Down>	frame|icon	f.post_wmenu
	<Btn3Down>	root		f.menu	DefaultRootMenu
	Alt<Btn1Down>	window|icon	f.lower
}
 
Buttons PointerButtonBindings
{
	<Btn1Down>	frame|icon	f.raise
	<Btn3Down>	frame|icon	f.post_wmenu
	<Btn3Down>	root		f.menu	DefaultRootMenu
	<Btn1Down>	window		f.raise
	Alt<Btn1Down>	window|icon	f.lower
}

! Window manager behaviour.
!
! Everything in this block used to live in the X resource database
! (Emwm*name in app-defaults or .Xdefaults). It is read from here now, and
! what is set here overrides any leftover X resource of the same name.
! See doc/CONFIGURATION.md for every available setting.

Settings
{
	! Draw window contents while moving, rather than an outline
	moveOpaque		False
	outlineWidth		4

	! Number of workspaces to create at startup
	workspaceCount		4

	! Icon layout. Defaults to left to right, bottom to top.
	iconPlacement		left bottom

	! If False, the root menu is unposted when the button is released
	rootButtonClick		False

	! Whether the active Xinerama screen follows the pointer or the focus
	xineramaScreenFocus	pointer

	! Whether windows are always iconified to the primary Xinerama screen
	xineramaIconifyToPrimary	False

	! Primary Xinerama screen index
	primaryXineramaScreen	0

	! Commands run by f.shutdown, f.reboot and f.suspend. Point these at
	! whatever your system uses; leave one empty to disable its function.
	shutdownCommand		"systemctl poweroff"
	rebootCommand		"systemctl reboot"
	suspendCommand		"systemctl suspend"

	! Run lockCommand after this many idle minutes. 0 disables the timer.
	! Locking is left to a program of your choosing; mWizard only runs it.
	! Bind f.exec to the same command to lock on demand.
	lockCommand		""
	lockTimeout		0

	! Shell used to run commands -- f.exec, the Execute dialog, the session
	! and tray commands, and the Startup block above. Empty uses $WMSHELL,
	! then $SHELL, then /bin/sh.
	!
	! Worth setting to /bin/sh if your login shell is a slow interactive
	! one: it is started afresh for every command, sourcing whatever your
	! profile does each time.
	execShell		""

	! System tray. mWizard has none of its own; this runs whichever one you
	! prefer, at startup, and skips it if a tray is already running. Empty
	! by default. A stalonetray config tuned for mWizard is installed
	! alongside this file.
	! trayCommand		"stalonetray -c /etc/X11/stalonetrayrc"
	trayCommand		""
}

! Per-application overrides. The name is the client's resource name or
! class, as reported by xprop(1) WM_CLASS.
!
! Client XTerm
! {
!	clientDecoration	-resizeh
!	focusAutoRaise		False
! }
!
! Client blocks match WM_CLASS, which is a property of the program itself --
! so unlike f.exec strings they cannot use $TERMINAL. Name the actual class
! of whichever terminal you set, e.g. "Client Alacritty" or "Client st".

! The system tray. The shipped stalonetrayrc asks for a full Motif frame and
! does not call itself a dock, so the tray behaves like any other window:
! moved, resized, minimized and maximized by its frame. Only Close is taken
! away -- closing the tray would strand the icons docked in it, and there is
! no way to get it back short of f.restart.
!
! "-close" starts from every function and subtracts, so new functions stay
! available. Spell it "move minimize" instead to list what is allowed rather
! than what is not. It stays on every workspace through "sticky true" in
! stalonetrayrc; "occupyWorkspaces all" here does the same thing from this
! side if your tray does not set _NET_WM_STATE_STICKY.
!
! The block name is matched against WM_CLASS -- check yours with
! "xprop WM_CLASS" and click the tray, since it varies between builds.
Client stalonetray
{
	clientFunctions		-close
	clientTitle		Tray
}

! A tray that announces itself as a dock instead gets no frame and move as
! its only function, and nothing here can add either back -- the window type
! is applied before this block. Such a tray needs no configuration at all.

! Per-workspace settings. Workspaces are named ws0, ws1 and so on.
!
! Workspace ws0
! {
!	title			Web
! }
