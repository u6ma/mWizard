# stalonetray configuration for mWizard.
#
# Copy to ~/.stalonetrayrc to customize, or point stalonetray at this file
# directly. mWizard runs it for you when trayCommand is set in your rc file:
#
#     Settings
#     {
#         trayCommand   "stalonetray -c /etc/X11/stalonetrayrc"
#     }
#
# See stalonetray(1) for every option.

# Full Motif frame. stalonetray sets this through _MOTIF_WM_HINTS, which
# mWizard honours natively, so the tray gets the same borders as any other
# window and can be moved and resized by them.
decorations all

# Treated as an ordinary window rather than a dock.
#
# mWizard maps _NET_WM_WINDOW_TYPE_DOCK onto no decoration at all and move as
# the only permitted function, so a dock has no frame to grab and can never be
# resized. Set this back to "dock" to get that behaviour -- but note that
# "decorations all" cannot override it: the window type is applied first and
# the frame is then intersected with what the client asks for, so nothing can
# add back what the dock branch removed.
window_type normal

# No reserved screen edge.
#
# A window you can move and resize cannot sensibly reserve one: maximized
# windows would go on avoiding a band the tray may have been dragged out of.
# Use "auto" together with "window_type dock" if you would rather have the
# tray own an edge and keep maximized windows clear of it.
window_strut none

# Keep the tray on every workspace and out of window lists. mWizard honours
# _NET_WM_STATE_STICKY on any window, so this still works without dock type.
sticky true
skip_taskbar true

# Stack like any other window. mWizard does not implement _NET_WM_STATE_BELOW,
# and a framed tray you interact with should not be pinned under everything.
window_layer normal

# Icon slot geometry. icon_size is the icon itself, slot_size the cell it
# sits in; width and height below are counted in slots, not pixels.
icon_size 22
slot_size 24
geometry 4x1

# Grow to the left as icons are added, filling from the right.
grow_gravity E
icon_gravity NE

# Match the mWizard window background so the tray blends with the frames.
background "#d2d2d2"

# Work around trays being repositioned, and icons that ignore the slot size.
# Without fix_window_pos the tray tends to drift when the window manager
# reconfigures it.
kludges fix_window_pos,force_icons_size

# Some dockapps only behave in this mode.
dockapp_mode simple

# Do not shrink back when icons are removed, so the tray does not jump about.
no_shrink false

max_geometry 0x0
transparent false
tint_level 0
scrollbars none
xsync false
