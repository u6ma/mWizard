# Common Makefile part, included in every platform scpecific Makefile

# -lXss (libXScrnSaver) is needed only by the idle lock timer. Drop it here
# together with -DIDLE_LOCK below to build without that feature; nothing else
# in mWizard uses it.
SYSLIBS =  -lm -lXm -lXt -lXext -lXrandr -lXinerama -lXss -lX11

# IDLE_LOCK enables the lockTimeout idle lock timer, which reads the X idle
# counter through the MIT-SCREEN-SAVER extension and therefore needs -lXss.
DEFINES = -DUNMAP_ON_RESTART -DIDLE_LOCK -DRCDIR='"$(RCDIR)"'

CFLAGS += $(DEFINES)

mwm_objs = \
	WmCDInfo.o WmCDecor.o WmCEvent.o WmCPlace.o WmColormap.o WmError.o \
	WmEvent.o WmFeedback.o WmFunction.o	WmGraphics.o WmIDecor.o WmIPlace.o \
	WmIconBox.o WmKeyFocus.o WmMain.o WmManage.o WmProperty.o WmResCvt.o\
	WmResParse.o WmResource.o WmSignal.o WmWinConf.o WmWinInfo.o WmWinList.o \
	WmWinState.o WmSession.o WmSettings.o WmImage.o WmInitWs.o WmMenu.o	WmProtocol.o \
	WmPresence.o WmWrkspace.o WmXinerama.o WmMonitor.o WmMonitorDlg.o \
	WmEwmh.o WmExecDlg.o \
	WmWinfo.o WmStyle.o

mwm_hdrs = \
	WmBitmap.h WmCDecor.h WmCDInfo.h WmCEvent.h WmCmd.h WmColormap.h \
	WmCPlace.h WmDebug.h WmError.h WmEvent.h WmEwmh.h WmExecDlg.h \
	WmFeedback.h WmFunction.h WmGlobal.h WmGraphics.h WmIBitmap.h \
	WmICCC.h WmIconBox.h WmIDecor.h WmImage.h WmInitWs.h WmIPlace.h \
	WmKeyFocus.h WmManage.h WmMenu.h WmMonitor.h WmMonitorDlg.h \
	WmPresence.h WmProperty.h \
	WmProtocol.h WmResCvt.h WmResNames.h WmResource.h WmResParse.h \
	WmSession.h WmSettings.h WmSignal.h WmStyle.h WmWinConf.h WmWinfo.h \
	WmWinInfo.h WmWinList.h WmWinState.h WmWrkspace.h WmXinerama.h \
	WmXmP.h xbm/mwizard_logo.xbm

mwizard: $(mwm_objs)
	$(CC) $(LDFLAGS) $(LIBDIRS) -o $@ $(mwm_objs) $(SYSLIBS)

# Every object depends on every header.
#
# Coarse on purpose. This replaces a generated .depend, which was wired up on
# two of the six platform makefiles, was written without $(DEFINES) so it did
# not see conditional includes, and -- having no prerequisites of its own --
# was never regenerated once it existed. The failure it caused is a quiet one:
# a header changes, make rebuilds nothing, and the binary keeps the old value
# compiled into it. Editing MWM_VERSION in WmGlobal.h and finding the About
# window still naming the previous release is what it looks like.
#
# The cost is that touching one header rebuilds all of them, which on a
# program this size is a few seconds. It is a plain prerequisite list, so it
# works under BSD make and GNU make alike and there is nothing to generate --
# but it does have to be kept in step with the headers, the same way mwm_objs
# is kept in step with the sources.
$(mwm_objs): $(mwm_hdrs)

.PHONY: clean install common_install install-goodies uninstall-goodies

clean:
	-rm -f $(mwm_objs) $(wsm_objs) mwizard

common_install:
	install -m 755 -d $(PREFIX)/bin
	install -m 755 mwizard $(PREFIX)/bin/mwizard
	install -m 755 -d $(MANDIR)/man1
	install -m 644 mwizard.1 $(MANDIR)/man1/mwizard.1
	install -m 755 -d $(MANDIR)/man4
	install -m 644 mwizardrc.4 $(MANDIR)/man4/mwizardrc.4
	install -m 755 -d $(RCDIR)
	install -m 644 system.mwizardrc $(RCDIR)/system.mwizardrc
	install -m 644 system.mstylesrc $(RCDIR)/system.mstylesrc
	install -m 644 stalonetrayrc $(RCDIR)/stalonetrayrc
	install -m 644 dunstrc $(RCDIR)/dunstrc

# --- goodies -------------------------------------------------------------
#
# Extras by alx@fastestcode.org under CC BY-SA 3.0. That license requires the
# attribution and the COPYING files to travel with the content, which is why
# each COPYING is installed alongside.
#
# Driven from the top level; GOODIES_BLD is passed in from there.

GOODIES_BLD = ../goodies/build
ICONDIR = $(PREFIX)/share/mwizard/icons
CURSORDIR = $(PREFIX)/share/icons
BITMAPDIR = $(RCDIR)/bitmaps

install-goodies:
	install -m 755 -d $(ICONDIR)
	install -m 644 $(GOODIES_BLD)/icons/*.xpm $(ICONDIR)
	install -m 644 $(GOODIES_BLD)/icons/COPYING $(ICONDIR)/COPYING
	install -m 755 -d $(BITMAPDIR)
	install -m 644 $(GOODIES_BLD)/dlgicons/32px/* $(BITMAPDIR)
	install -m 644 $(GOODIES_BLD)/dlgicons/README $(BITMAPDIR)/README.dlgicons
	@if [ -d $(GOODIES_BLD)/xc-core-hr/core-hr ]; then \
		echo "installing cursor theme"; \
		install -m 755 -d $(CURSORDIR)/core-hr/cursors; \
		cp -R $(GOODIES_BLD)/xc-core-hr/core-hr/cursors/. \
			$(CURSORDIR)/core-hr/cursors/; \
		install -m 644 $(GOODIES_BLD)/xc-core-hr/COPYING \
			$(CURSORDIR)/core-hr/COPYING; \
	else \
		echo "NOTE: cursor theme was not built, skipping it."; \
	fi
	@echo ""
	@echo "GTK configs are per-user files and were not installed. To use them:"
	@echo "    cp $(GOODIES_BLD)/gtk-configs/gtkrc-2.0 ~/.gtkrc-2.0"
	@echo "    mkdir -p ~/.config/gtk-3.0"
	@echo "    cp $(GOODIES_BLD)/gtk-configs/gtk.css ~/.config/gtk-3.0/gtk.css"
	@echo ""
	@echo "Icons are in $(ICONDIR); point bitmapDirectory at it."
	@echo "For the cursor theme set Xcursor.theme: core-hr"

uninstall-goodies:
	-rm -rf $(ICONDIR)
	-rm -rf $(CURSORDIR)/core-hr
	-rm -f $(BITMAPDIR)/README.dlgicons
	-for f in xm_error xm_information xm_question xm_warning xm_working; do \
		rm -f $(BITMAPDIR)/$$f; \
	done

uninstall:
	rm -f $(PREFIX)/bin/mwizard
	rm -f $(MANDIR)/man1/mwizard.1
	rm -f $(MANDIR)/man4/mwizardrc.4
	rm -f $(RCDIR)/system.mwizardrc
	rm -f $(RCDIR)/system.mstylesrc
	rm -f $(RCDIR)/stalonetrayrc
	rm -f $(RCDIR)/dunstrc
	# Left over from before appearance moved into the style file; removed
	# here so an upgrade-then-uninstall does not strand it.
	rm -f $(APPLRESDIR)/MWizard

