!! mWizard application defaults
!!
!! This file carries APPEARANCE ONLY: colors, shadows and fonts.
!!
!! Window manager behaviour -- focus policy, placement, workspaces, icon
!! handling, session commands and so on -- is configured in the rc file
!! (~/.mwizardrc), not here. See doc/CONFIGURATION.md, and the Settings
!! block in system.mwizardrc for the list.
!!
!! Behaviour settings left in this file or in .Xdefaults are overridden by
!! the rc file and will appear to have no effect.

!! Window decoration colors
MWizard*client*background: #8C8C8C
MWizard*client*activeBackground: #7399BA
MWizard*icon*activeBackground: #7399BA

!! The Workspace Presence dialog
MWizard*feedback*XmPushButton.marginWidth: 5
MWizard*feedback*XmPushButton.marginHeight: 5

!! Default font (menus and dialogs)
MWizard*renderTable: variable
MWizard*renderTable.variable.fontType: FONT_IS_XFT
MWizard*renderTable.variable.fontName: Liberation Sans
MWizard*renderTable.variable.fontSize: 10

!! The mWinfo (About) window's product name
!!
!! Deliberately not called "title": that name already belongs to the window
!! frame's title font below, and a widget named "title" anywhere would pick it
!! up. This is the one string in mWizard meant to be read at a glance.
MWizard*productName.renderTable: winfoTitle
MWizard*renderTable.winfoTitle.fontType: FONT_IS_XFT
MWizard*renderTable.winfoTitle.fontName: Liberation Sans
MWizard*renderTable.winfoTitle.fontSize: 24
MWizard*renderTable.winfoTitle.fontStyle: Bold

!! Title bar font
MWizard*title.renderTable: title
MWizard*renderTable.title.fontType: FONT_IS_XFT
MWizard*renderTable.title.fontName: Liberation Sans
MWizard*renderTable.title.fontSize: 10
MWizard*renderTable.title.fontStyle: Bold

!! Icon label font
MWizard*icon.renderTable: icon
MWizard*renderTable.icon.fontType: FONT_IS_XFT
MWizard*renderTable.icon.fontName: Liberation Sans
MWizard*renderTable.icon.fontSize: 10
MWizard*renderTable.icon.fontStyle: Italic
